# TypeSafe JEV API key (required for Live analysis mode only)
# Get a key at https://console.typesafe.ai
# Copy this file to backend/.env (preferred) or .env at the repo root.
# Never commit real keys. The key is read by the Python backend only.
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Backend bind (optional)
HOST=127.0.0.1
PORT=8000

# Live JEV pacing / concurrency (optional)
JEV_CONCURRENCY=3
JEV_TIMEOUT_SECONDS=60
JEV_LIVE_PACE_SECONDS=0.35

# Optional comma-separated browser origins allowed to call the backend.
# Defaults include localhost/127.0.0.1 on Vite ports 5173 and 4173.
# CORS_ORIGINS=https://your-ui.example

# Frontend (optional). Vite proxy already forwards /api and /health in dev.
# VITE_API_BASE=http://127.0.0.1:8000
